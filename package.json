{
  "name": "csslint-mod",
  "version": "1.0.13",
  "description": "A CSSLint fork supporting modern CSS, primarily used in the Stylus extension",
  "author": "Stylus Team",
  "license": "MIT",
  "repository": "openstyles/csslint-mod",
  "homepage": "https://github.com/openstyles/csslint-mod#readme",
  "keywords": [
    "CSS",
    "linter"
  ],
  "files": [
    "dist",
    "src/lib"
  ],
  "main": "dist/csslint.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint \"**/*.js\" --cache",
    "test": "pnpm run-p lint self-test",
    "self-test": "node --import=extensionless/register test/test.js",
    "preversion": "pnpm test && pnpm run build && git add dist",
    "bump": "pnpm version patch",
    "bump2": "pnpm version minor"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "eslint": "^10.6.0",
    "extensionless": "^2.0.6",
    "fs-extra": "^11.3.6",
    "globals": "^17.7.0",
    "npm-run-all2": "^9.0.2",
    "rollup": "^4.62.2"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
