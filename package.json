{
  "name": "csslint-mod",
  "version": "1.0.19",
  "description": "A CSSLint fork supporting modern CSS, primarily used in the Stylus extension",
  "author": "Stylus Team",
  "license": "MIT",
  "repository": "openstyles/csslint-mod",
  "homepage": "https://github.com/openstyles/csslint-mod#readme",
  "keywords": [
    "CSS",
    "linter"
  ],
  "files": [
    "dist",
    "src/lib"
  ],
  "main": "dist/csslint.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint \"**/*.js\" --cache",
    "test": "pnpm run-p lint test-dev",
    "test-build": "node test/test.js build",
    "test-dev": "node --import=extensionless/register test/test.js",
    "preversion": "pnpm test && pnpm build && pnpm test-build && git add dist",
    "bump": "pnpm version patch",
    "bump2": "pnpm version minor"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "chalk": "^6.0.1",
    "eslint": "^10.12.0",
    "extensionless": "^2.0.6",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.3",
    "rollup": "^4.64.5",
    "rollup-plugin-define": "^1.0.1",
    "rollup-plugin-re": "^1.0.7"
  },
  "packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5"
}
